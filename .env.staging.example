# 中文：内部 staging compose 的环境变量示例。复制为 .env.staging 并填入 staging secret。
# English: Example environment file for internal staging compose. Copy to .env.staging and fill staging secrets.

ORIGAMI_ENV=staging
ORIGAMI_API_IMAGE=origami-devops-platform-api:staging
ORIGAMI_API_TOKEN=replace-with-staging-internal-token
ORIGAMI_ALLOWED_ORIGINS=https://origami-staging.internal
ORIGAMI_TRUSTED_HOSTS=origami-staging.internal,127.0.0.1,localhost
ORIGAMI_ACTOR_HEADER=X-Origami-Actor
ORIGAMI_TRUSTED_PROXY_AUTH_REQUIRED=true
ORIGAMI_GRAFANA_URL=https://origami-staging.internal/grafana/d/origami-overview?orgId=1
ORIGAMI_LOG_LEVEL=INFO
ORIGAMI_METRICS_AUTH_REQUIRED=false
ORIGAMI_RUN_RETENTION_LIMIT=100
ORIGAMI_SCENARIO_CONFIG_DIR=/var/lib/origami/artifacts/configs/scenarios

# Bind to localhost when an internal TLS reverse proxy owns external access.
ORIGAMI_API_BIND=127.0.0.1:8000
PROMETHEUS_BIND=127.0.0.1:9090
GRAFANA_BIND=127.0.0.1:3000
GRAFANA_ROOT_URL=https://origami-staging.internal/grafana

GRAFANA_ADMIN_USER=origami-staging-admin
GRAFANA_ADMIN_PASSWORD=replace-with-staging-strong-password

# Google Workspace / Gmail SSO via oauth2-proxy and the docker-compose.sso.yml overlay.
ORIGAMI_SSO_BIND=127.0.0.1:8080
OAUTH2_PROXY_CLIENT_ID=replace-with-staging-google-oauth-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-staging-google-oauth-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64-url-secret
OAUTH2_PROXY_REDIRECT_URL=https://origami-staging.internal/oauth2/callback
OAUTH2_PROXY_COOKIE_DOMAINS=origami-staging.internal
OAUTH2_PROXY_WHITELIST_DOMAINS=origami-staging.internal
# Temporary single-account staging access:
# - Keep GOOGLE_WORKSPACE_DOMAIN empty so gmail.com is not broadly allowed.
# - Copy configs/auth/oauth2-proxy/authenticated-emails.txt.example to
#   configs/auth/oauth2-proxy/authenticated-emails.txt and put the allowed Gmail
#   address there on the staging host.
GOOGLE_WORKSPACE_DOMAIN=
OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE=/etc/oauth2-proxy/authenticated-emails.txt

# Used by scripts/staging_sso_smoke.sh after the stack is reachable.
ORIGAMI_STAGING_BASE_URL=https://origami-staging.internal
# Optional: set when running the smoke check from the staging host or VPN.
ORIGAMI_STAGING_DIRECT_API_URL=http://127.0.0.1:8000
