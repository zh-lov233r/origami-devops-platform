# 中文：内部生产 compose 的环境变量示例。复制为 .env.production 并填入真实 secret。
# English: Example environment file for internal production compose. Copy to .env.production and fill real secrets.

ORIGAMI_ENV=production
ORIGAMI_API_IMAGE=origami-devops-platform-api:0.1.0
ORIGAMI_API_TOKEN=replace-with-internal-token
ORIGAMI_ALLOWED_ORIGINS=https://origami.internal
ORIGAMI_TRUSTED_HOSTS=origami.internal,127.0.0.1,localhost
ORIGAMI_ACTOR_HEADER=X-Origami-Actor
ORIGAMI_GRAFANA_URL=https://origami.internal/grafana/d/origami-overview?orgId=1
ORIGAMI_LOG_LEVEL=INFO
ORIGAMI_METRICS_AUTH_REQUIRED=false
ORIGAMI_RUN_RETENTION_LIMIT=500
ORIGAMI_SCENARIO_CONFIG_DIR=/var/lib/origami/artifacts/configs/scenarios

# Bind to localhost by default so an internal reverse proxy or VPN gateway owns external access.
ORIGAMI_API_BIND=127.0.0.1:8000
PROMETHEUS_BIND=127.0.0.1:9090
GRAFANA_BIND=127.0.0.1:3000
GRAFANA_ROOT_URL=https://origami.internal/grafana

GRAFANA_ADMIN_USER=origami-admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password
